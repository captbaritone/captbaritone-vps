# Bans the addresses that keep trying.
#
# Measured before being written: over four days this host saw 84,115 ssh
# connection attempts from 1,341 addresses, and 822 of those tried more than
# five times. 79,086 of the attempts -- 94% -- came after a given address's
# fifth, which is to say after the point where a jail would have stopped
# listening to it. The traffic is a few hundred persistent scanners rather than
# a spread-out botnet, which is the shape this helps with; against one attempt
# per address it would arrive too late to matter.
#
# The sshd drop-in beside this raises MaxStartups and caps connections per
# source. The two are not alternatives. This reduces the load; that one stops
# the remaining load from refusing a deploy. Keep both: a ban list only knows
# about behaviour it has already seen.

[DEFAULT]
# Long enough to be a deterrent, short enough that a fumbled key is not a
# lockout for the day.
bantime  = 1h
findtime = 10m
maxretry = 5

# Never ban the loopback. Nothing here should be able to lock the host out of
# itself.
ignoreip = 127.0.0.1/8 ::1

# Read from the journal rather than a file. Both exist on this host, but the
# journal is the one systemd guarantees, and it does not depend on rsyslog
# staying installed.
backend = systemd

[sshd]
enabled = true
port    = ssh

# Addresses that come back after a ban get a much longer one.
#
# The worst single address in the measurement made 1,219 attempts. An hour at a
# time would let it return twenty-four times a day; this makes the second
# offence cost a week.
[recidive]
enabled  = true
bantime  = 1w
findtime = 1d
maxretry = 3
