[Unit]
Description=Record audio versions of jordaneldredge.com posts every day at 4:15

[Timer]
# After the museum order at 03:00, beside the light FindOpera jobs at 04:20
# and 04:40, and before the 05:05 backup so new audio rows are in that
# night's copy.
OnCalendar=*-*-* 04:15
Persistent=true

[Install]
WantedBy=timers.target
